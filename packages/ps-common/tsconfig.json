{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": [
    "index.ts",
    "checkerboard.ts",
    "i18n/**/*.ts",
    "schemas/**/*.ts",
    "sdk/**/*.js"
  ],
  "exclude": ["node_modules", "dist"]
}
